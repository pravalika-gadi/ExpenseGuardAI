# ExpenseGuard AI — Environment Configuration (Optional)
# Copy this file to .env if you wish to override default local settings.

# Ollama local inference server URL
OLLAMA_BASE_URL=http://localhost:11434

# Default local LLM model for explainable AI summaries (e.g. llama3.2:latest, llama3.1:latest, mistral:latest)
OLLAMA_MODEL=llama3.2:latest

# Ollama inference timeout in seconds
OLLAMA_TIMEOUT=20

# Streamlit port and server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
